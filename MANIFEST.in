# What goes into the source distribution.
# The wheel is built from [tool.setuptools] packages, so this only shapes the
# sdist: ship the package and the documents a user needs, leave out the
# development scripts that live at the repository root.

include LICENSE
include README.md
include requirements.txt
recursive-include togoid py.typed
recursive-include docs *.md
recursive-include examples *.py *.md *.sh

exclude test_*.py
exclude test_*.sh
exclude PROJECT_STRUCTURE.md
exclude CHANGELOG_SUMMARY.md
exclude QUICKSTART_UV.md
prune tasks
